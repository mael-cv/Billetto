# Copier en .env — ne jamais commiter .env
POSTGRES_USER=billetto_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=billetto
POSTGRES_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@billetto.local
PGADMIN_DEFAULT_PASSWORD=change-me

# Compte propriétaire (migrations / seed). Le compte applicatif restreint arrive au lot E.
DATABASE_URL=postgresql://billetto_owner:change-me@localhost:5433/billetto

API_PORT=3001
CORS_ORIGIN=http://localhost:3000
SEED=20260916
