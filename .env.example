# Copier en .env — ne jamais commiter .env
POSTGRES_USER=billetto_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=billetto
POSTGRES_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@billetto.org
PGADMIN_DEFAULT_PASSWORD=change-me

# Compte propriétaire (migrations / seed). Le compte applicatif restreint arrive au lot E.
DATABASE_URL=postgresql://billetto_owner:change-me@localhost:5433/billetto

# Compte applicatif restreint (rôles + RLS) utilisé par l'API à partir de la phase 06.
APP_DB_PASSWORD=change-me-app
APP_DATABASE_URL=postgresql://billetto_app:change-me-app@localhost:5433/billetto

API_PORT=3001
CORS_ORIGIN=http://localhost:3000
# Secret de signature des sessions (≥ 32 caractères). Générer :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplacer-par-un-secret-aleatoire-de-48-octets-minimum
SESSION_TTL_SECONDS=7200
# false uniquement pour un navigateur qui refuse les cookies Secure en http://localhost
COOKIE_SECURE=true
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
LOG_LEVEL=info
# Mot de passe des comptes demo-*@billetto.test (développement uniquement)
DEMO_PASSWORD=Billetto-Demo-2026!
SEED=20260916
