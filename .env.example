# Copier en .env — ne jamais commiter .env.
# Facultatif : sans .env, docker-compose.yml utilise des valeurs de démonstration équivalentes.
# Un .env présent à la racine remplace ces défauts (Compose le charge automatiquement).
POSTGRES_USER=billetto_owner
POSTGRES_PASSWORD=billetto_owner_pass
POSTGRES_DB=billetto
POSTGRES_PORT=5433

PGADMIN_DEFAULT_EMAIL=admin@billetto.org
PGADMIN_DEFAULT_PASSWORD=billetto-pgadmin

# Compte propriétaire (migrations / seed uniquement).
DATABASE_URL=postgresql://billetto_owner:billetto_owner_pass@localhost:5433/billetto

# Compte applicatif restreint (rôles + RLS) utilisé par l'API à partir de la phase 06.
APP_DB_PASSWORD=billetto_app_pass
APP_DATABASE_URL=postgresql://billetto_app:billetto_app_pass@localhost:5433/billetto

# Compte BI / pgAdmin en lecture seule (billetto_bi, hérite de billetto_readonly).
READONLY_DB_PASSWORD=billetto_bi_pass

API_PORT=3001
CORS_ORIGIN=http://localhost:3000
# Secret de signature des sessions (≥ 32 caractères). Générer :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-jwt-secret-billetto-0123456789abcdef
# HMAC-SHA256 du corps brut du webhook (≥ 32 caractères, requis par docker compose). Générer un secret distinct :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYMENTS_WEBHOOK_SECRET=
SESSION_TTL_SECONDS=7200
# false uniquement pour un navigateur qui refuse les cookies Secure en http://localhost
COOKIE_SECURE=true
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
LOG_LEVEL=info
# Mot de passe des comptes demo-*@billetto.test — DÉVELOPPEMENT UNIQUEMENT, jamais en production.
# Choisir une valeur locale (lue par le seed, les tests e2e et security-audit).
DEMO_PASSWORD=Billetto-Demo-2026!
SEED=20260916

# --- E-mails (phase 15) ---
# Mailpit (docker compose up -d mailpit) capture les e-mails : http://localhost:8025
# Laisser vide pour désactiver l'envoi (les e-mails restent dans emails_sortants).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Billetto <billets@billetto.local>
EMAIL_OUTBOX_INTERVAL_MS=10000

# --- Docker Hub & Publication pour le rendu ---
DOCKER_USER=monpseudo

# --- Base NoSQL MongoDB (Templates des billets et des événements) ---
MONGO_USER=billetto_mongo
MONGO_PASSWORD=billetto_mongo_pass
MONGO_DB=billetto_nosql
MONGO_PORT=27017
MONGO_URL=mongodb://billetto_mongo:billetto_mongo_pass@localhost:27017/billetto_nosql?authSource=admin

