{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug security-audit (pentest)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@billetto/security-audit", "exec", "tsx", "src/cli.ts", "--pentest", "--profile", "standard", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug security-audit (white-box)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@billetto/security-audit", "exec", "tsx", "src/cli.ts", "--sast", "--secrets", "--dependencies", "--infra", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
