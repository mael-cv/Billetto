  statut         String       @default("active")
  mode_paiement  String
  prix_unitaire  Decimal      @db.Decimal(10, 2)
  expire_a       DateTime     @db.Timestamptz(6)
  commande_id    BigInt?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
