generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model amities {
  id                                                BigInt       @id(map: "pk_amities") @default(autoincrement())
  utilisateur_id                                    BigInt
  ami_id                                            BigInt
  statut                                            String       @default("pending")
  created_at                                        DateTime     @default(now()) @db.Timestamptz(6)
  utilisateurs_amities_ami_idToutilisateurs         utilisateurs @relation("amities_ami_idToutilisateurs", fields: [ami_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_amities_ami_id")
  utilisateurs_amities_utilisateur_idToutilisateurs utilisateurs @relation("amities_utilisateur_idToutilisateurs", fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_amities_utilisateur_id")

  @@unique([utilisateur_id, ami_id], map: "uq_amities_utilisateur_id_ami_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model billets {
  id             BigInt       @id(map: "pk_billets") @default(autoincrement())
  tarif_id       BigInt
  commande_id    BigInt
  utilisateur_id BigInt
  code           String       @unique(map: "uq_billets_code") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prix_paye      Decimal      @db.Decimal(10, 2)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  commandes      commandes    @relation(fields: [commande_id], references: [id], onUpdate: NoAction, map: "fk_billets_commande_id")
  tarifs         tarifs       @relation(fields: [tarif_id], references: [id], onUpdate: NoAction, map: "fk_billets_tarif_id")
  utilisateurs   utilisateurs @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction, map: "fk_billets_utilisateur_id")

  @@index([commande_id], map: "idx_billets_commande_id")
  @@index([tarif_id], map: "idx_billets_tarif_id")
  @@index([utilisateur_id], map: "idx_billets_utilisateur_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model commandes {
  id             BigInt         @id(map: "pk_commandes") @default(autoincrement())
  utilisateur_id BigInt
  statut         String         @default("pending")
  montant_total  Decimal        @default(0) @db.Decimal(12, 2)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  billets        billets[]
  utilisateurs   utilisateurs   @relation(fields: [utilisateur_id], references: [id], onUpdate: NoAction, map: "fk_commandes_utilisateur_id")
  paiements      paiements[]
  reservations   reservations[]

  @@index([utilisateur_id], map: "idx_commandes_utilisateur_id")
}

