  organisateurs       organisateurs         @relation(fields: [organisateur_id], references: [id], onUpdate: NoAction, map: "fk_evenements_organisateur_id")
  type_evenements     type_evenements       @relation(fields: [type_evenement_id], references: [id], onUpdate: NoAction, map: "fk_evenements_type_evenement_id")
