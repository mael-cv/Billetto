{
  "name": "billetto",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "infra:up": "docker compose up -d --wait postgres pgadmin",
    "infra:down": "docker compose down",
    "dev": "pnpm -r --parallel --filter @billetto/web --filter @billetto/api dev",
    "build": "pnpm -r --filter @billetto/web --filter @billetto/api build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "pnpm -r --if-present format",
    "db:migrate": "pnpm --filter @billetto/database migrate",
    "db:reset": "pnpm --filter @billetto/database reset",
    "db:seed:small": "pnpm --filter @billetto/database seed small",
    "db:seed:full": "pnpm --filter @billetto/database seed full",
    "db:pull": "pnpm --filter @billetto/api prisma:pull"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  }
}
