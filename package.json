{
  "name": "billetto",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "infra:up": "docker compose up -d --wait postgres pgadmin mailpit",
    "infra:down": "docker compose down",
    "dev": "pnpm -r --parallel --filter @billetto/web --filter @billetto/api dev",
    "build": "pnpm -r --filter @billetto/web --filter @billetto/api build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present --filter !@billetto/database test",
    "format": "pnpm -r --if-present format",
    "db:init": "pnpm --filter @billetto/database run setup",
    "db:migrate": "pnpm --filter @billetto/database migrate",
    "db:reset": "pnpm --filter @billetto/database reset",
    "db:seed:small": "pnpm --filter @billetto/database seed small",
    "db:seed:full": "pnpm --filter @billetto/database seed full",
    "db:pull": "pnpm --filter @billetto/api prisma:pull",
    "db:refresh-mv": "pnpm --filter @billetto/database refresh-mv",
    "db:test": "pnpm --filter @billetto/database test",
    "db:benchmark": "pnpm --filter @billetto/database benchmark",
    "db:seed:demo": "pnpm --filter @billetto/database seed:demo",
    "test:e2e": "pnpm --filter @billetto/api test:e2e",
    "test:load": "pnpm --filter @billetto/api test:load",
    "test:e2e:web": "pnpm --filter @billetto/web test:e2e",
    "security-audit": "pnpm --filter @billetto/security-audit exec tsx src/cli.ts",
    "security-audit:full": "pnpm --filter @billetto/security-audit exec tsx src/cli.ts --full",
    "security-audit:install-scanners": "pnpm --filter @billetto/security-audit install-scanners",
    "db:seed:nosql": "pnpm --filter @billetto/database seed:nosql",
    "db:queries:nosql": "pnpm --filter @billetto/database queries:nosql",
    "db:test:nosql": "pnpm --filter @billetto/database test:nosql"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.5",
      "deepmerge-ts": "^8.0.2",
      "source-map-js": "^1.2.2"
    }
  }
}
