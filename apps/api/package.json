{
  "name": "@billetto/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "prisma:pull": "dotenv -e ../../.env -- prisma db pull",
    "prisma:generate": "prisma generate",
    "test:e2e": "dotenv -e ../../.env -v NODE_OPTIONS=--experimental-vm-modules -- jest --config test/jest-e2e.json --runInBand"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.16.0",
    "fastify": "5.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "prisma": "^6.16.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": "\\.spec\\.ts$"
  }
}
